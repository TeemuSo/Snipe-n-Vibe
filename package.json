{
  "name": "dayzcopy",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev:client": "npm -w packages/client run dev",
    "dev:server": "npm -w packages/server run dev",
    "build:shared": "npm -w packages/shared run build",
    "build": "npm run build:shared && npm -w packages/client run build && npm -w packages/server run build"
  }
}
